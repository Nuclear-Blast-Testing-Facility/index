# Redis Database Configuration (Supports either Upstash REST or standard Redis URL)
REDIS_URL="redis://default:password@your-redis-host:6379"

# Or Upstash REST API (Recommended for Vercel Edge/Serverless):
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Public site domain
NUXT_PUBLIC_SITE_URL="https://index.nbtf.ca"
